# Local development only. Never commit your real .env.
MONGODB_URL=mongodb+srv://username:password@cluster0.xxxxxxx.mongodb.net/asset_marketplace?appName=Cluster0
DATABASE_NAME=asset_marketplace

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bootstrap only. The password is hashed before storage.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

CORS_ORIGINS=http://localhost:5173
APP_ENV=development
LOG_LEVEL=INFO
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
